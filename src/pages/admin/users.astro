---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Gestion des Rôles & Utilisateurs — HIGH YA ! Admin" activeTab="users">
  <div class="c-admin__content">
    <div class="c-admin__card">
      <div class="c-admin__card-header">
        <div>
          <h2 class="c-admin__card-title">Attribution & Contrôle des 4 Rôles Clerk</h2>
          <p style="font-size: 0.8rem; color: var(--hy-color-muted); margin-top: 2px;">
            Zone réservée au <strong>Super Admin</strong>. Modifiez les privilèges des comptes enregistrés.
          </p>
        </div>
      </div>

      <div class="c-admin__table-wrapper">
        <table class="c-admin__table">
          <thead>
            <tr>
              <th>Utilisateur</th>
              <th>Email</th>
              <th>Date Inscription</th>
              <th>Rôle Actuel</th>
              <th>Modifier le Rôle</th>
              <th>Statut Privilège</th>
            </tr>
          </thead>
          <tbody id="users-table-body">
            <!-- Sample and synced Clerk users -->
            <tr>
              <td>
                <div style="font-weight: 800; color: #fff;">Stefi Blokhauss (Fondateur)</div>
                <div style="font-size: 0.75rem; color: var(--hy-color-muted); font-family: var(--hy-font-mono);">user_2tX98akj711</div>
              </td>
              <td>admin@high-ya.com</td>
              <td>01 Oct 2026</td>
              <td><span class="c-badge c-badge--super-admin">Super Admin</span></td>
              <td>
                <select class="c-admin__role-select user-role-change" data-user="user_2tX98akj711">
                  <option value="super admin" selected>Super Admin</option>
                  <option value="vendeurs">Vendeurs</option>
                  <option value="vip">VIP</option>
                  <option value="public">Public</option>
                </select>
              </td>
              <td style="color: #ff5277; font-weight: 700; font-size: 0.75rem;">Accès Total & Gestion Rôles</td>
            </tr>

            <tr>
              <td>
                <div style="font-weight: 800; color: #fff;">Amadou Ba (Responsable Ventes Dakar)</div>
                <div style="font-size: 0.75rem; color: var(--hy-color-muted); font-family: var(--hy-font-mono);">user_8vL92pkz402</div>
              </td>
              <td>vendeur.dakar@high-ya.com</td>
              <td>03 Oct 2026</td>
              <td><span class="c-badge c-badge--vendeur">Vendeurs</span></td>
              <td>
                <select class="c-admin__role-select user-role-change" data-user="user_8vL92pkz402">
                  <option value="super admin">Super Admin</option>
                  <option value="vendeurs" selected>Vendeurs</option>
                  <option value="vip">VIP</option>
                  <option value="public">Public</option>
                </select>
              </td>
              <td style="color: var(--hy-color-acid); font-weight: 700; font-size: 0.75rem;">Gestion Commandes & Wave</td>
            </tr>

            <tr>
              <td>
                <div style="font-weight: 800; color: #fff;">Marc Lefebvre</div>
                <div style="font-size: 0.75rem; color: var(--hy-color-muted); font-family: var(--hy-font-mono);">user_3mQ44ytr983</div>
              </td>
              <td>marc.lefebvre@example.com</td>
              <td>05 Oct 2026</td>
              <td><span class="c-badge c-badge--vip">VIP</span></td>
              <td>
                <select class="c-admin__role-select user-role-change" data-user="user_3mQ44ytr983">
                  <option value="super admin">Super Admin</option>
                  <option value="vendeurs">Vendeurs</option>
                  <option value="vip" selected>VIP</option>
                  <option value="public">Public</option>
                </select>
              </td>
              <td style="color: var(--hy-color-gold); font-weight: 700; font-size: 0.75rem;">Remise Boutique -20%</td>
            </tr>

            <tr>
              <td>
                <div style="font-weight: 800; color: #fff;">Visiteur Anonyme (Défaut)</div>
                <div style="font-size: 0.75rem; color: var(--hy-color-muted); font-family: var(--hy-font-mono);">anonymous_session</div>
              </td>
              <td>Non renseigné</td>
              <td>Aujourd'hui</td>
              <td><span class="c-badge c-badge--public">Public</span></td>
              <td>
                <select class="c-admin__role-select user-role-change" data-user="anonymous_session">
                  <option value="super admin">Super Admin</option>
                  <option value="vendeurs">Vendeurs</option>
                  <option value="vip">VIP</option>
                  <option value="public" selected>Public</option>
                </select>
              </td>
              <td style="color: var(--hy-color-muted); font-weight: 700; font-size: 0.75rem;">Tarifs Normaux</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Role Permissions Summary Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--hy-space-md); margin-top: var(--hy-space-xl);">
      <div class="c-admin__stat-card">
        <span class="c-badge c-badge--super-admin" style="align-self: flex-start;">Super Admin</span>
        <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-top: 0.5rem;">Pouvoirs Absolus</h4>
        <p style="font-size: 0.8rem; color: var(--hy-color-muted); line-height: 1.5;">
          Accès complet à la plateforme : modification des rôles utilisateurs, paramétrage de la devise (XOF, EUR, USD), visualisation des revenus globaux.
        </p>
      </div>

      <div class="c-admin__stat-card">
        <span class="c-badge c-badge--vendeur" style="align-self: flex-start;">Vendeurs</span>
        <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-top: 0.5rem;">Équipe Commerciale</h4>
        <p style="font-size: 0.8rem; color: var(--hy-color-muted); line-height: 1.5;">
          Accès au tableau de bord des commandes : validation des encaissements Wave, mise à jour des expéditions et livraisons des paquets.
        </p>
      </div>

      <div class="c-admin__stat-card">
        <span class="c-badge c-badge--vip" style="align-self: flex-start;">VIP</span>
        <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-top: 0.5rem;">Membres Privilège</h4>
        <p style="font-size: 0.8rem; color: var(--hy-color-muted); line-height: 1.5;">
          Clients fidélisés bénéficiant d'une remise automatique de 20% sur tous les paquets et cartouches, et accès à l'édition limitée Obsidian Onyx.
        </p>
      </div>

      <div class="c-admin__stat-card">
        <span class="c-badge c-badge--public" style="align-self: flex-start;">Public</span>
        <h4 style="font-size: 1rem; font-weight: 800; color: #fff; margin-top: 0.5rem;">Tous les Visiteurs</h4>
        <p style="font-size: 0.8rem; color: var(--hy-color-muted); line-height: 1.5;">
          Rôle par défaut pour toute personne non connectée ou tout utilisateur ordinaire. Tarifs publics standards et navigation libre.
        </p>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.user-role-change').forEach(select => {
    select.addEventListener('change', (e: any) => {
      const newRole = e.target.value;
      alert(`Le rôle de l'utilisateur a été mis à jour en : ${newRole.toUpperCase()}`);
    });
  });
</script>
