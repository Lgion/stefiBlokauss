---
import '../styles/main.scss';
import RoleSwitcher from '../components/RoleSwitcher.astro';

interface Props {
  title?: string;
  activeTab?: 'overview' | 'orders' | 'users' | 'settings';
}

const { title = "Administration — HIGH YA !", activeTab = 'overview' } = Astro.props;
const currentRole = Astro.locals.currentRole || 'super admin';
const isSuperAdmin = currentRole === 'super admin';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="c-admin">
    <header class="c-admin__header">
      <div class="c-admin__brand-group">
        <a href="/admin" class="c-admin__logo">
          HIGH YA ! <span style="color: var(--hy-color-gold); font-size: 0.9rem; margin-left: 4px;">// ADMIN</span>
        </a>

        <span class={`c-badge c-badge--${isSuperAdmin ? 'super-admin' : 'vendeur'}`}>
          {isSuperAdmin ? 'Super Admin' : 'Vendeur Commercial'}
        </span>
      </div>

      <nav class="c-admin__nav">
        <a href="/admin" class={`c-admin__nav-link ${activeTab === 'overview' ? 'c-admin__nav-link--active' : ''}`}>
          Vue d'ensemble
        </a>

        <a href="/admin/orders" class={`c-admin__nav-link ${activeTab === 'orders' ? 'c-admin__nav-link--active' : ''}`}>
          Commandes Wave
        </a>

        {isSuperAdmin && (
          <a href="/admin/users" class={`c-admin__nav-link ${activeTab === 'users' ? 'c-admin__nav-link--active' : ''}`}>
            Gestion des Rôles
          </a>
        )}

        {isSuperAdmin && (
          <a href="/admin/settings" class={`c-admin__nav-link ${activeTab === 'settings' ? 'c-admin__nav-link--active' : ''}`}>
            Paramètres & Devise
          </a>
        )}

        <a href="/" class="c-product-card__btn-details" style="padding: 0.4rem 0.8rem; font-size: 0.75rem; margin-left: 1rem;">
          ← Boutique
        </a>
      </nav>
    </header>

    <main class="c-admin__main">
      <div class="l-container">
        <slot />
      </div>
    </main>

    <RoleSwitcher currentRole={currentRole} />
  </body>
</html>
